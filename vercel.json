{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/parse",
      "destination": "/api/parse.js"
    },
    {
      "source": "/api/download",
      "destination": "/api/download.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/public/$1"
    }
  ]
}
